# ── Firebase web app config ─────────────────────────────────────────────
# Firebase console → Project settings → Your apps → SDK setup and configuration.
# These identify your project to the browser; they are not secrets, but keep real
# values in .env.local (git-ignored). NEVER put service-account keys here.
VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.asia-southeast1.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Region the `api` Cloud Function is deployed to (must match functions/src/index.ts).
VITE_FUNCTIONS_REGION=asia-southeast1

# ── Local development ───────────────────────────────────────────────────
# true → connect to the Firebase Emulator Suite (auth 9099, database 9000, functions 5001)
# and use the demo project below. `npm run dev:emu` sets this for you.
VITE_USE_EMULATORS=false
VITE_EMULATOR_PROJECT_ID=demo-ipl-auction
VITE_EMULATOR_HOST=127.0.0.1
