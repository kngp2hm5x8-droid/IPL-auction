    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "firebase-admin": "^13.4.0",
    "firebase-functions": "^6.4.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "~6.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
